# Copy to .env.local and fill in. Without these the site runs as a demo only:
# /ru/app says the server is not connected, /ru/demo works fully in the browser.

# PostgreSQL (Supabase project "Questling": Project Settings → Database → Connection string →
# Transaction pooler). Secret: server and scripts/migrate.mjs only.
DATABASE_URL=

# The Telegram bot whose Mini App this is (@BotFather). Secret: used to check sign-in data.
TELEGRAM_BOT_TOKEN=

# At least 32 random characters, to sign sessions. Secret.
SESSION_SECRET=

# Teacher Studio sign-in (Supabase Auth of the same project: Project Settings → API). Public values:
# the project's URL and its anon key. Without them the studio's live sign-in says it is not configured.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Large media (teacher videos and images, students' voice recordings): a PRIVATE bucket on any
# S3-compatible storage; Backblaze B2 by default (docs/media-storage.md). Secret values: the server
# only signs short-lived links with them; the browser never sees them. Without these, voice acting
# uploads say "storage is not connected" (the demo works with its built-in clip).
#   MEDIA_S3_ENDPOINT  e.g. https://s3.eu-central-003.backblazeb2.com   (the bucket's "Endpoint", with https://)
#   MEDIA_S3_REGION    e.g. eu-central-003                              (the middle part of the endpoint)
MEDIA_S3_ENDPOINT=
MEDIA_S3_REGION=
MEDIA_S3_BUCKET=
MEDIA_S3_ACCESS_KEY_ID=
MEDIA_S3_SECRET_ACCESS_KEY=
# Optional: the whole bucket's budget in bytes (default 8 GiB, below B2's free 10 GB), when to warn
# (fractions of it), and signed download links per day (default 2000).
MEDIA_GLOBAL_CAP_BYTES=
MEDIA_WARN_AT=0.7,0.9
MEDIA_DAILY_DOWNLOADS=
# Daily housekeeping (Vercel Cron calls /api/v1/cron/media-cleanup with "Bearer CRON_SECRET"):
# at least 16 random characters. Secret.
CRON_SECRET=

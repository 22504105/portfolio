# Copy to .env.local and fill in. Without these the site runs as a demo only:
# /ru/app says the server is not connected, /ru/demo works fully in the browser.

# PostgreSQL (Supabase project "Questling": Project Settings → Database → Connection string →
# Transaction pooler). Secret: server and scripts/migrate.mjs only.
DATABASE_URL=

# The Telegram bot whose Mini App this is (@BotFather). Secret: used to check sign-in data.
TELEGRAM_BOT_TOKEN=

# At least 32 random characters, to sign sessions. Secret.
SESSION_SECRET=

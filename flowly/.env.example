# Flowly needs no configuration to run: the public demo works with this file
# absent. The variables below switch on accounts and private workspaces
# (Phase 3). Copy to .env.local and fill in.

# Supabase project URL and its publishable (anon) key. Both are meant for the
# browser. NEVER put a secret or service-role key in a NEXT_PUBLIC_ variable:
# those are sent to every visitor.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Splitly needs no configuration to run: the browser demo works with this file
# absent. The variables below arrive with the stages that use them. Copy to
# .env.local and fill in. Nothing here may ever get a NEXT_PUBLIC_ name unless
# it says so: those are sent to every visitor.

# --- Stage 2: Telegram sign-in ------------------------------------------------
# The bot's token from @BotFather. A SECRET: it signs every sign-in.
TELEGRAM_BOT_TOKEN=
# At least 32 random characters. Signs Splitly's own sessions. A SECRET.
SESSION_SECRET=

# --- Stage 2: database ----------------------------------------------------------
# PostgreSQL connection string (Supabase: Connect -> Transaction pooler). A
# SECRET, used by the server only.
DATABASE_URL=

# Copy to .env.local and fill in. Nothing here is needed to build the site or
# to run the tests; the values are needed once pages read from the database.

# --- Supabase (Project Settings -> API) ------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The publishable (anon) key. Safe in the browser: row level security applies.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# The secret (service role) key. Bypasses row level security. Server only.
SUPABASE_SECRET_KEY=

# --- Application ------------------------------------------------------------
# Public origin, without a trailing slash. Used for the links in emails.
APP_URL=http://localhost:3000

# --- Email (Resend) ---------------------------------------------------------
# Leave empty in development: emails then go to the local mail sink, not out.
RESEND_API_KEY=
EMAIL_FROM="CUT&CO <bookings@cutco.example>"

# --- Scheduler --------------------------------------------------------------
# At least 32 random characters. Sent by the cron job, checked by the handler.
CRON_SECRET=

# Copy to .env.local and fill in. `npm run db:dev` writes a working .env.local
# for local development by itself. Nothing here is needed to build the site or
# to run the tests: without a database the site uses its built-in catalog and
# the booking page shows a preview.

# --- Database ----------------------------------------------------------------
# PostgreSQL connection string. On Supabase: Project Settings -> Database ->
# Connection string -> Transaction pooler. Server only.
DATABASE_URL=
# Optional: the PEM certificate authority of the database, to verify its
# certificate. Supabase: Project Settings -> Database -> SSL configuration.
DATABASE_CA_CERT=

# --- Application ---------------------------------------------------------------
# Public origin, without a trailing slash. Used for the links in emails.
APP_URL=http://localhost:3000
# At least 32 random characters. Signs the session opened from a booking email.
SESSION_SECRET=

# --- Email (Resend) ------------------------------------------------------------
# Leave empty in development: emails then go to .tmp/mail and can be read at
# /en/dev/mail. In production an empty key means emails fail and stay queued.
RESEND_API_KEY=
EMAIL_FROM="CUT&CO <bookings@cutco.example>"

# --- Scheduler -----------------------------------------------------------------
# At least 32 random characters. The scheduler sends it as a Bearer token to
# /api/cron/notifications, which sends due emails, expires stale holds and
# clears out stale personal data.
CRON_SECRET=

# --- Supabase Auth (accounts and staff sign-in) ----------------------------------
# The publishable key only. A secret or service-role key must never be put in
# a NEXT_PUBLIC_ variable: those are sent to every visitor's browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
